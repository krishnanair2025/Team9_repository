<?xml version="1.0"?>
<sdf version='1.10'>
  <world name='empty'>
    <physics name='1ms' type='ignored'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Core plugins -->
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system'/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin name="gz::sim::systems::Imu" filename="gz-sim-imu-system"/>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>5.5645e-06 2.28758e-05 -4.23884e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Ground plane: white -->
    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Boundary mesh: black -->
    <model name='outer_boundary'>
      <link name='link'>
        <visual name='visual'>
          <geometry>
            <mesh>
              <uri>file:///home/student14/Team9_repository/Workspaces/nav_ws/src/config/example_search_area.stl</uri>
              <scale>0.001 0.001 0.001</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
        <collision name='collision'>
          <geometry>
            <mesh>
              <uri>file:///home/student14/Team9_repository/Workspaces/nav_ws/src/config/example_search_area.stl</uri>
              <scale>0.01 0.01 0.01</scale>
            </mesh>
          </geometry>
        </collision>
      </link>
      <static>true</static>
    </model>

    <!-- Target object 1 -->
    <model name='obj_box'>
      <pose>0.5 0.25 0.103 0 0 0</pose>
      <link name='obj_box_link'>
        <collision name='obj_box_collision'>
          <geometry><box><size>0.205 0.205 0.205</size></box></geometry>
        </collision>
        <visual name='obj_box_visual'>
          <geometry><box><size>0.205 0.205 0.205</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
      <static>true</static>
    </model>

    <model name='target_cylinder_1'>
      <pose>0.5 0.25 0.239 0 0 0</pose>
      <link name='target_cylinder_1_link'>
        <inertial>
          <mass>0.02</mass>
          <inertia><ixx>8e-06</ixx><iyy>8e-06</iyy><izz>1.8e-06</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name='target_cylinder_1_collision'>
          <geometry><cylinder><radius>0.0134</radius><length>0.067</length></cylinder></geometry>
        </collision>
        <visual name='target_cylinder_1_visual'>
          <geometry><cylinder><radius>0.0134</radius><length>0.067</length></cylinder></geometry>
          <material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material>
        </visual>
      </link>
      <static>false</static>
    </model>

    <!-- Target object 2 -->
    <model name='obj_2_box'>
      <pose>0.5 5.5 0.103 0 0 0</pose>
      <link name='obj_box_2_link'>
        <collision name='obj_box_2_collision'>
          <geometry><box><size>0.205 0.205 0.205</size></box></geometry>
        </collision>
        <visual name='obj_box_2_visual'>
          <geometry><box><size>0.205 0.205 0.205</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
      <static>true</static>
    </model>

    <model name='target_cylinder_2'>
      <pose>0.5 5.5 0.239 0 0 0</pose>
      <link name='target_cylinder_2_link'>
        <inertial>
          <mass>0.02</mass>
          <inertia><ixx>8e-06</ixx><iyy>8e-06</iyy><izz>1.8e-06</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name='target_cylinder_2_collision'>
          <geometry><cylinder><radius>0.0134</radius><length>0.067</length></cylinder></geometry>
        </collision>
        <visual name='target_cylinder_2_visual'>
          <geometry><cylinder><radius>0.0134</radius><length>0.067</length></cylinder></geometry>
          <material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material>
        </visual>
      </link>
      <static>false</static>
    </model>

    <!-- Target object 3 -->
    <model name='obj_3_box'>
      <pose>1.3899 3.1221 0.103 0 0 0</pose>
      <link name='obj_box_3_link'>
        <collision name='obj_box_3_collision'>
          <geometry><box><size>0.205 0.205 0.205</size></box></geometry>
        </collision>
        <visual name='obj_box_3_visual'>
          <geometry><box><size>0.205 0.205 0.205</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
      <static>true</static>
    </model>

    <model name='target_cylinder_3'>
      <pose>1.3899 3.1221 0.239 0 0 0</pose>
      <link name='target_cylinder_3_link'>
        <inertial>
          <mass>0.02</mass>
          <inertia><ixx>8e-06</ixx><iyy>8e-06</iyy><izz>1.8e-06</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name='target_cylinder_3_collision'>
          <geometry><cylinder><radius>0.0134</radius><length>0.067</length></cylinder></geometry>
        </collision>
        <visual name='target_cylinder_3_visual'>
          <geometry><cylinder><radius>0.0134</radius><length>0.067</length></cylinder></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
      </link>
      <static>false</static>
    </model>
    
    
    <model name="overhead_tracking_camera">
      <static>true</static>

      <link name="camera_link">
        <!-- Position: center of 6x7 area, above -->
        <!-- Rotation: looking straight down -->
        <pose>2.0 3.0 6 0 1.5708 0</pose>

        <sensor name="overhead_camera" type="camera">
          <update_rate>30</update_rate>

          <camera>
            <horizontal_fov>1.2</horizontal_fov> <!-- ~69 deg -->
            
            <image>
              <width>1024</width>
              <height>768</height>
              <format>R8G8B8</format>
            </image>

            <clip>
              <near>0.1</near>
              <far>50</far>
            </clip>
          </camera>

          <!-- Use correct plugin for gz sim -->
          <plugin name="overhead_camera_controller" filename="libgz_ros2_camera.so">
            <ros>
              <namespace>/overhead_camera</namespace>
            </ros>
          </plugin>

        </sensor>
      </link>
    </model>


<!-- 5x4 point light grid -->
