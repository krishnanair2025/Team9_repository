<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="tracking_cameras">

  <!-- ============================
       TRACKING CAMERA 1 (rear elevated, angled down)
  ============================= -->
  <link name="tracking_cam_1_link"/>

  <joint name="tracking_cam_1_joint" type="fixed">
    <parent link="base_link"/>
    <child link="tracking_cam_1_link"/>
    <!-- 1000 mm up (z), 1000 mm back (x negative), pitched down 45 deg -->
    <origin xyz="-0.75 0.0 0.85" rpy="0 0.785398 0"/>
  </joint>

  <gazebo reference="tracking_cam_1_link">
    <sensor name="tracking_cam_1" type="camera">
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>800</width>
          <height>600</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
      </camera>
      <plugin name="tracking_cam_1_controller" filename="libgz_ros_camera.so">
        <ros>
          <namespace>/tracking_cam_1</namespace>
        </ros>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ============================
       TRACKING CAMERA 2 (side profile)
  ============================= -->
  <link name="tracking_cam_2_link"/>

  <joint name="tracking_cam_2_joint" type="fixed">
    <parent link="base_link"/>
    <child link="tracking_cam_2_link"/>
    <!-- 500 mm to the right (+y), rotated to face robot -->
    <origin xyz="0.0 0.75 0.85" rpy="0 0.785398 -1.5708"/>
  </joint>

  <gazebo reference="tracking_cam_2_link">
    <sensor name="tracking_cam_2" type="camera">
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>800</width>
          <height>600</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
      </camera>
      <plugin name="tracking_cam_2_controller" filename="libgz_ros_camera.so">
        <ros>
          <namespace>/tracking_cam_2</namespace>
        </ros>
      </plugin>
    </sensor>
  </gazebo>

</robot>
