<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================
       LIDAR MOUNTING JOINT
  ============================= -->
  <joint name="rplidar_joint" type="fixed">
    <!-- Position of lidar relative to rover base_link -->
    <origin xyz="${84.806/1000} 0 ${15/1000}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="rplidar_link"/>
  </joint>


  <!-- ============================
       LIDAR LINK + STL GEOMETRY
  ============================= -->
  <link name="rplidar_link">

    <!-- Visual model -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://leo_description/models/lidar_holder.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <!-- Collision model -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://leo_description/models/lidar_holder.stl"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

  </link>


  <!-- ============================
       GAZEBO GPU LIDAR SENSOR
  ============================= -->
  <gazebo reference="rplidar_link">
    <sensor name="base_scan" type="gpu_lidar">

      <!-- Sensor pose relative to rplidar_link -->
      <pose relative_to="rplidar_link">0 0 0.0495 0 0 0</pose>

      <topic>scan</topic>
      <gz_frame_id>rplidar_link</gz_frame_id>
      <update_rate>15</update_rate>

      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14</min_angle>
            <max_angle>3.14</max_angle>
          </horizontal>
        </scan>

        <range>
          <min>0.2225</min>
          <max>12</max>
          <resolution>0.005</resolution>
        </range>
      </lidar>

      <always_on>1</always_on>
      <visualize>1</visualize>

    </sensor>
  </gazebo>


  <!-- ============================
       TF LINK FOR SCAN FRAME
  ============================= -->
  <link name="leo_rover/base_footprint/base_scan"/>

  <joint name="scan_tf_joint" type="fixed">
    <origin xyz="0 0 ${49.5/1000}" rpy="0 0 ${-pi/2}"/>
    <parent link="rplidar_link"/>
    <child link="leo_rover/base_footprint/base_scan"/>
  </joint>

</robot>

